# 使用系统环境变量传入；程序不会自动读取本文件。
HOST=127.0.0.1
PORT=4317
# 对外部署时必须配置 HTTPS 的真实入口，并在 TLS 代理后启用安全 Cookie。
# PUBLIC_ORIGIN=https://reading.example.org
# COOKIE_SECURE=true
# DATA_DIR=/path/to/private/reading-data
# 默认不连接外部 STUN/TURN。需要跨网络语音时，在验证服务与授权后配置。
# RTC_ICE_SERVERS=[{"urls":"stun:your-server.example.org:3478"}]
